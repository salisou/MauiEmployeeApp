<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiEmployeeApp.MainPage"
             BackgroundColor="#F4F5F7"
             Title="Employee Manager">
    <Grid>

        <!-- CONTENUTO PRINCIPALE -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- SEARCH BAR -->
                <Border StrokeThickness="0"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 20"
                        Shadow="{Shadow Brush=#00000020, Offset='0,4', Radius=12}">
                    <SearchBar x:Name="SearchBar"
                               Placeholder="Search employees..."
                               TextChanged="SearchBar_TextChanged"
                               BackgroundColor="Transparent"
                               Margin="10"
                               FontSize="16"/>
                </Border>

                <!-- LISTA -->
                <CollectionView x:Name="EmployeeList"
                                SelectionMode="Single"
                                Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 18"
                                    Margin="0,8"
                                    Padding="14"
                                    Shadow="{Shadow Brush=#00000015, Offset='0,3', Radius=10}">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                                    <VerticalStackLayout>
                                        <Label Text="{Binding FullName}"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="#111" />

                                        <Label Text="{Binding Position}"
                                               FontSize="14"
                                               TextColor="#666" />

                                        <Label Text="{Binding Salary, StringFormat='{0:C}'}"
                                               FontSize="13"
                                               TextColor="#10B981" />
                                    </VerticalStackLayout>

                                    <Button Text="✕"
                                            Grid.Column="1"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            CornerRadius="20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Clicked="OnDelete_Clicked"/>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemDoubleTapped"
                                                              NumberOfTapsRequired="2"/>
                                    </Grid.GestureRecognizers>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- FLOATING ACTION BUTTON (NON COPRE IL CONTENUTO) -->
        <Button Text="+"
                Clicked="OnAddEmployee_Clicked"
                BackgroundColor="#10B981"
                TextColor="White"
                FontSize="28"
                CornerRadius="30"
                WidthRequest="60"
                HeightRequest="60"
                Shadow="{Shadow Brush=#00000040, Offset='0,4', Radius=12}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"/>
    </Grid>

</ContentPage>
